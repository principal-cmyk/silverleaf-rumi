<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Rumi Observability Portal</title>
  <link rel="icon" type="image/png" href="/images/rumi-logo.png">
  <link rel="stylesheet" href="/css/main.css">
  <% if (brand.fontHref) { %><link rel="stylesheet" href="<%= brand.fontHref %>"><% } %>
  <style>
    /* The organisation's look, from env (dashboard/config/report-brand.js). Tints follow the brand's own shades. */
    .rpt-body {
      --brand: <%= brand.colours.primary %>;
      --accent: <%= brand.colours.accent %>;
      --hl: <%= brand.colours.highlight %>;
      --neutral: <%= brand.colours.neutral %>;
      --brand-50: color-mix(in srgb, var(--brand) 50%, #fff);
      --accent-30: color-mix(in srgb, var(--accent) 30%, #fff);
      --neutral-15: color-mix(in srgb, var(--neutral) 15%, #fff);
      --neutral-8: color-mix(in srgb, var(--neutral) 8%, #fff);
      --hl-15: color-mix(in srgb, var(--hl) 15%, #fff);
      --ink: #1c2230;
      --ink-soft: color-mix(in srgb, var(--neutral) 75%, #000);
      --sans: <% if (brand.sansFont) { %>'<%= brand.sansFont %>', <% } %>'Helvetica Neue', Helvetica, Arial, sans-serif;
      --serif: <% if (brand.serifFont) { %>'<%= brand.serifFont %>', <% } %>Georgia, 'Times New Roman', serif;
      background: var(--neutral-8);
      color: var(--ink);
      font-family: var(--sans);
    }
    .rpt-page { max-width: 64rem; margin: 0 auto; padding: 5.5rem 1rem 3rem; }
    .rpt-page > * + * { margin-top: 1.25rem; }

    .rpt-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; }
    .rpt-back { color: var(--brand); font-size: .875rem; font-weight: 600; }
    .rpt-back:hover { text-decoration: underline; }
    .rpt-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
    .rpt-download { display: inline-flex; align-items: center; gap: .4rem; padding: .55rem 1rem; border-radius: .5rem;
      background: var(--brand); color: #fff; font-size: .875rem; font-weight: 600; white-space: nowrap; border: 1px solid var(--brand); }
    .rpt-download:hover { background: color-mix(in srgb, var(--brand) 85%, #000); }
    .rpt-download:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .rpt-download.secondary { background: #fff; color: var(--brand); }
    .rpt-download.secondary:hover { background: var(--accent-30); }

    /* Header band: the brand colour, with the logo in its bottom-left corner. */
    .rpt-band { background: var(--brand); color: #fff; border-radius: .75rem; padding: 1.75rem 2rem 1.25rem;
      display: flex; flex-direction: column; gap: 1.25rem; }
    .rpt-eyebrow { color: var(--accent); font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .rpt-teacher { font-size: 2rem; line-height: 1.15; font-weight: 700; margin-top: .35rem; }
    .rpt-meta { font-family: var(--serif); font-size: 1.05rem; color: color-mix(in srgb, #fff 82%, var(--brand)); margin-top: .35rem; }
    .rpt-band-logo { width: 15rem; max-width: 60%; height: auto; margin-left: -1.6rem; margin-bottom: -.9rem; }

    .rpt-card { background: #fff; border-radius: .75rem; padding: 1.5rem 1.75rem; border: 1px solid var(--neutral-15); }
    .rpt-h2 { color: var(--brand); font-size: 1.15rem; font-weight: 700; }
    .rpt-h3 { color: var(--ink); font-size: 1rem; font-weight: 700; margin-bottom: .5rem; }
    .rpt-sub { font-family: var(--serif); color: var(--ink-soft); font-size: .95rem; }
    .rpt-lede { font-size: 1.02rem; line-height: 1.6; color: var(--ink); }
    .rpt-small { font-size: .85rem; color: var(--ink-soft); }
    .rpt-list { list-style: disc; margin-left: 1.25rem; }
    .rpt-list li + li { margin-top: .35rem; }
    .rpt-notice { background: var(--hl-15); border: 1px solid var(--hl); border-radius: .5rem; padding: .75rem 1rem; font-size: .9rem; }

    /* Summary: the level on the left, one bar per strand on the right. */
    .rpt-summary { display: grid; gap: 1.5rem; }
    @media (min-width: 768px) { .rpt-summary { grid-template-columns: 15rem 1fr; align-items: start; } }
    .rpt-level { border-right: 0; }
    @media (min-width: 768px) { .rpt-level { border-right: 1px solid var(--neutral-15); padding-right: 1.5rem; } }
    .rpt-level-name { color: var(--brand); font-size: 2.25rem; font-weight: 700; line-height: 1.1; margin-top: .4rem; }
    .rpt-level-pct { color: var(--ink-soft); font-size: 1.25rem; font-weight: 600; margin-top: .15rem; }
    .rpt-bar-row { display: grid; grid-template-columns: minmax(8rem, 11rem) 1fr auto; gap: .75rem; align-items: center; }
    .rpt-bar-row + .rpt-bar-row { margin-top: .8rem; }
    @media (max-width: 520px) { .rpt-bar-row { grid-template-columns: 1fr auto; } .rpt-bar-track { grid-column: 1 / -1; grid-row: 2; } }
    .rpt-bar-name { font-size: .9rem; font-weight: 600; }
    .rpt-bar-value { font-size: .85rem; color: var(--ink-soft); white-space: nowrap; }
    .rpt-bar-value b { color: var(--ink); font-weight: 600; }
    .rpt-bar-track { position: relative; height: 12px; border-radius: 4px; background: var(--neutral-15); overflow: hidden; }
    .rpt-bar-fill { height: 100%; border-radius: 4px; background: var(--brand); }
    .rpt-bar-none { height: 100%; border: 1px dashed var(--neutral); border-radius: 4px; background: transparent; opacity: .6; }
    .rpt-ticks { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(255,255,255,.9) 1px, transparent 1px);
      background-size: 25% 100%; pointer-events: none; }

    /* Progress line. */
    .rpt-chart { width: 100%; min-width: 480px; height: auto; display: block; font-family: var(--sans); }
    .rpt-chart .grid { stroke: var(--neutral-15); stroke-width: 1; }
    .rpt-chart .axis { fill: var(--ink-soft); font-size: 11px; }
    .rpt-chart .line { fill: none; stroke: var(--brand); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
    .rpt-chart .dot { fill: var(--brand); stroke: #fff; stroke-width: 2; }
    .rpt-chart .dot.current { fill: #fff; stroke: var(--brand); stroke-width: 3; }
    .rpt-chart .hit { fill: transparent; }
    .rpt-chart .val { fill: var(--brand); font-size: 12px; font-weight: 700; }
    .rpt-table th, .rpt-table td { padding: .2rem 1.5rem .2rem 0; }

    /* The action step is the one thing to act on: the highlight colour, used only here. */
    .rpt-action { background: var(--hl-15); border-color: color-mix(in srgb, var(--hl) 50%, #fff); border-left: 6px solid var(--hl); }
    .rpt-action-step { font-size: 1.15rem; font-weight: 600; color: var(--ink); margin-top: .5rem; }
    .rpt-steps { list-style: decimal; margin: .6rem 0 0 1.25rem; }
    .rpt-steps li + li { margin-top: .25rem; }
    .rpt-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .25rem; }
    .rpt-tag { font-size: .75rem; font-weight: 600; color: var(--brand); background: #fff; border: 1px solid var(--brand-50);
      border-radius: 999px; padding: .1rem .6rem; }

    .rpt-two { display: grid; gap: 1.25rem; }
    @media (min-width: 768px) { .rpt-two { grid-template-columns: 1fr 1fr; } }
    .rpt-col { border-top: 4px solid var(--accent); padding-top: .75rem; }
    .rpt-col.grows { border-top-color: var(--neutral); }
    .rpt-note { border-left: 3px solid var(--accent); padding: .25rem 0 .25rem 1rem; font-family: var(--serif); font-size: 1.05rem;
      line-height: 1.6; color: var(--ink); }

    .rpt-fold > summary { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; }
    .rpt-fold > summary::-webkit-details-marker { display: none; }
    .rpt-fold > summary::after { content: '+'; color: var(--brand); font-size: 1.4rem; font-weight: 300; line-height: 1; }
    .rpt-fold[open] > summary::after { content: '–'; }
    .rpt-sub-fold { border: 1px solid var(--neutral-15); border-radius: .5rem; padding: .7rem .9rem; }
    .rpt-sub-fold + .rpt-sub-fold { margin-top: .5rem; }
    .rpt-sub-fold > summary { cursor: pointer; font-weight: 600; font-size: .95rem; }
    .rpt-level-chip { font-weight: 600; color: var(--brand); }
    .rpt-evidence > div + div { border-top: 1px solid var(--neutral-15); }

    .rpt-record-only, .rpt-title-record { display: none; }

    /* Download PDF = the browser's print-to-PDF. Everything folded on screen is opened by the script below. */
    @media print {
      @page { margin: 12mm; }
      html { font-size: 13.5px; }
      body { background: #fff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      /* A printed page is narrower than the desktop breakpoint: keep the side-by-side layouts. */
      .rpt-two { grid-template-columns: 1fr 1fr; }
      .rpt-summary { grid-template-columns: 14rem 1fr; }
      .rpt-level { border-right: 1px solid var(--neutral-15); padding-right: 1.5rem; }
      body[data-print="record"] .rpt-summary { grid-template-columns: 1fr; }
      body[data-print="record"] .rpt-level { border-right: 0; }
      .rpt-band { padding: 1.4rem 1.75rem 1rem; gap: .9rem; }
      .rpt-band-logo { width: 12rem; }
      .rpt-card { padding: 1.1rem 1.4rem; }
      nav, .rpt-noprint { display: none !important; }
      .rpt-page { max-width: none; padding: 0; }
      .rpt-page > * + * { margin-top: .9rem; }
      /* Cards may run across pages; the pieces inside them stay whole and a heading stays with what follows it. */
      .rpt-band, .rpt-bar-row, .rpt-chart, .rpt-sub-fold, .rpt-level, li, .rpt-note { break-inside: avoid; }
      .rpt-h2, .rpt-h3, .rpt-action-step { break-after: avoid; }
      .rpt-chart { min-width: 0; }
      .rpt-fold > summary::after { content: none !important; }
      summary { list-style: none; }
      summary::-webkit-details-marker { display: none; }
      /* Observation record: the short record only, no charts, evidence or reflection. */
      body[data-print="record"] .rpt-report-only, body[data-print="record"] .rpt-title-report { display: none !important; }
      body[data-print="record"] .rpt-record-only { display: block !important; }
      body[data-print="record"] .rpt-title-record { display: inline !important; }
    }
  </style>
</head>
<body class="rpt-body min-h-screen">
  <%- include("partials/navigation", { currentPage: "coaching", username: username, userRole: userRole }) %>

  <div class="rpt-page"
       data-print-name="<%= report.teacher %> - <%= new Date(report.date).toISOString().slice(0, 10) %>">
    <div class="rpt-toolbar rpt-noprint">
      <a href="/observability/coaching" class="rpt-back">← All coaching sessions</a>
      <div class="rpt-actions">
        <button type="button" class="rpt-download" data-on-click="printReport"
                title="The full report. Opens the print dialog: choose Save as PDF">⬇ Download PDF</button>
        <% if (report.available) { %>
          <button type="button" class="rpt-download secondary" data-on-click="printRecord"
                  title="Level, action step, glows, grows and the note only. Opens the print dialog: choose Save as PDF">⬇ Observation record</button>
        <% } %>
      </div>
    </div>

    <header class="rpt-band">
      <div>
        <p class="rpt-eyebrow"><span class="rpt-title-report">Observation report</span><span class="rpt-title-record">Observation record</span></p>
        <h1 class="rpt-teacher"><%= report.teacher %></h1>
        <p class="rpt-meta">
          <%= [report.classTaught, report.school].filter(Boolean).join(' · ') %><% if (report.classTaught || report.school) { %> · <% } %><%= new Date(report.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %><% if (report.durationSeconds) { %> · <%= Math.floor(report.durationSeconds / 60) %>:<%= String(report.durationSeconds % 60).padStart(2, '0') %> min<% } %>
        </p>
        <% if (report.available && (report.subject || report.topic)) { %>
          <p class="rpt-meta"><%= [report.subject, report.topic].filter(Boolean).join(' · ') %></p>
        <% } %>
      </div>
      <% if (brand.hasLogoOnDark) { %>
        <img class="rpt-band-logo" src="/observability/brand/logo-on-dark" alt="<%= brand.orgName || 'Logo' %>">
      <% } %>
    </header>

    <% if (report.summary) { %>
      <section class="rpt-card">
        <p class="rpt-lede"><%= report.summary %></p>
      </section>
    <% } %>

    <% if (!report.available) { %>
      <p class="rpt-notice">
        There is no full report for this lesson, because it was scored before the current framework was in use.
      </p>
    <% } else { %>
      <section class="rpt-card">
        <div class="rpt-summary">
          <div class="rpt-level">
            <h2 class="rpt-h2">Summary</h2>
            <p class="rpt-level-name"><%= report.record.overall_level || 'Not rated' %></p>
            <p class="rpt-level-pct"><%= Math.round(report.scores.overall_percentage) %>% overall</p>
            <p class="rpt-small" style="margin-top:.5rem">
              Across the <%= report.scores.rated_indicators %> of <%= report.scores.total_indicators %> indicators this lesson could show.
              Indicators not observed do not lower the score.
            </p>
          </div>
          <div class="rpt-report-only" role="list" aria-label="Score by strand">
            <p class="rpt-sub" style="margin-bottom:.9rem">Score by strand</p>
            <% report.strandSummary.forEach((strand) => { %>
              <div class="rpt-bar-row" role="listitem"
                   title="<%= strand.name %>: <%= strand.observed ? `${strand.levelName} (${strand.percentage}%)` : 'not observed' %>">
                <span class="rpt-bar-name"><%= strand.name %></span>
                <div class="rpt-bar-track">
                  <% if (strand.observed) { %>
                    <div class="rpt-bar-fill" style="width: <%= Math.max(2, strand.percentage) %>%"></div>
                  <% } else { %>
                    <div class="rpt-bar-none"></div>
                  <% } %>
                  <div class="rpt-ticks"></div>
                </div>
                <span class="rpt-bar-value">
                  <% if (strand.observed) { %><b><%= strand.levelName %></b> · <%= strand.percentage %>%<% } else { %>Not observed<% } %>
                </span>
              </div>
            <% }) %>
          </div>
        </div>
        <% if (report.record.lesson_start_seen === false) { %>
          <p class="rpt-small" style="margin-top:1rem">This recording does not show the start of the lesson, so the lesson opening is not observed.</p>
        <% } %>
      </section>

      <section class="rpt-card rpt-report-only">
        <h2 class="rpt-h2">Progress over time</h2>
        <% if (!report.trend.chart) { %>
          <p class="rpt-sub" style="margin-top:.4rem">This is <%= report.teacher %>'s first lesson scored on this framework, so there is no trend yet. It will appear after the next one.</p>
        <% } else { const c = report.trend.chart; %>
          <p class="rpt-sub" style="margin-top:.4rem">
            Overall score, last <%= report.trend.points %> lessons up to this one:
            <b style="color:var(--brand)"><%= report.trend.change > 0 ? `up ${report.trend.change}` : report.trend.change < 0 ? `down ${-report.trend.change}` : 'no change of' %> points</b>
            since <%= c.marks[0].label %>.<span class="rpt-noprint"> Hover a point for its strand scores.</span>
          </p>
          <div style="overflow-x: auto; margin-top: .75rem">
            <svg class="rpt-chart" viewBox="0 0 <%= c.width %> <%= c.height %>" role="img"
                 aria-label="Overall score by lesson, from <%= c.marks[0].pct %>% to <%= c.marks[c.marks.length - 1].pct %>%">
              <% c.gridlines.forEach((g) => { %>
                <line class="grid" x1="<%= c.left %>" x2="<%= c.width - c.right %>" y1="<%= g.y %>" y2="<%= g.y %>"></line>
                <text class="axis" x="<%= c.left - 6 %>" y="<%= g.y + 4 %>" text-anchor="end"><%= g.value %>%</text>
              <% }) %>
              <path class="line" d="<%= c.path %>"></path>
              <% c.marks.forEach((m) => { %>
                <g>
                  <title><%= m.tooltip %><%= m.current ? '\n(this lesson)' : '' %></title>
                  <circle class="hit" cx="<%= m.x %>" cy="<%= m.y %>" r="14"></circle>
                  <circle class="dot<%= m.current ? ' current' : '' %>" cx="<%= m.x %>" cy="<%= m.y %>" r="<%= m.current ? 6 : 4.5 %>"></circle>
                  <% if (m.current) { %>
                    <text class="val" x="<%= m.x %>" y="<%= m.y - 12 %>" text-anchor="middle"><%= m.pct %>%</text>
                  <% } %>
                  <% if (m.showLabel) { %>
                    <text class="axis" x="<%= m.x %>" y="<%= c.height - c.bottom + 20 %>" text-anchor="middle"><%= m.label %></text>
                  <% } %>
                </g>
              <% }) %>
            </svg>
          </div>
          <details class="rpt-noprint rpt-small" style="margin-top:.5rem">
            <summary style="cursor:pointer">Show as a table</summary>
            <table class="rpt-table" style="margin-top:.5rem">
              <thead><tr><th style="text-align:left">Lesson</th><th style="text-align:right">Overall</th></tr></thead>
              <tbody>
                <% c.marks.forEach((m) => { %>
                  <tr><td><%= m.label %><%= m.current ? ' (this lesson)' : '' %></td><td style="text-align:right"><%= m.pct %>%</td></tr>
                <% }) %>
              </tbody>
            </table>
          </details>
        <% } %>
      </section>

      <section class="rpt-card rpt-action">
        <h2 class="rpt-h2">Action step</h2>
        <% if (report.record.needs_review) { %>
          <p class="rpt-notice" style="margin-top:.5rem">
            A coach should review this step. It did not fully meet the rules: one move, drawn from the grows.
          </p>
        <% } %>
        <p class="rpt-action-step"><%= report.record.action_step %></p>
        <% if (report.record.how && report.record.how.length) { %>
          <ol class="rpt-steps">
            <% report.record.how.forEach((step) => { %><li><%= step %></li><% }) %>
          </ol>
        <% } %>
        <% if (report.record.source_grow || report.record.rationale) { %>
          <details style="margin-top:.75rem">
            <summary class="rpt-small" style="cursor:pointer">Why this step</summary>
            <div style="margin-top:.5rem; font-size:.9rem">
              <div class="rpt-tags">
                <% [report.record.category, report.record.type, report.record.gbf_phase, report.record.gbf_skill].filter(Boolean).forEach((tag) => { %><span class="rpt-tag"><%= tag %></span><% }) %>
              </div>
              <% if (report.record.source_grow) { %>
                <p style="margin-top:.5rem"><b>Drawn from this grow:</b> <%= report.record.source_grow %></p>
              <% } %>
              <% if (report.record.rationale) { %><p style="margin-top:.35rem"><%= report.record.rationale %></p><% } %>
            </div>
          </details>
        <% } %>
      </section>

      <section class="rpt-card">
        <div class="rpt-two">
          <div class="rpt-col">
            <h2 class="rpt-h2">Glows</h2>
            <p class="rpt-sub">What went well</p>
            <ul class="rpt-list" style="margin-top:.5rem"><% (report.record.glows || []).forEach((glow) => { %><li><%= glow %></li><% }) %></ul>
          </div>
          <div class="rpt-col grows">
            <h2 class="rpt-h2">Grows</h2>
            <p class="rpt-sub">What to work on</p>
            <ul class="rpt-list" style="margin-top:.5rem"><% (report.record.grows || []).forEach((grow) => { %><li><%= grow %></li><% }) %></ul>
          </div>
        </div>
        <% if (report.record.notes_for_teacher) { %>
          <div style="margin-top:1.5rem">
            <h2 class="rpt-h2">Note for the teacher</h2>
            <p class="rpt-note" style="margin-top:.5rem"><%= report.record.notes_for_teacher %></p>
          </div>
        <% } %>
        <% const v = report.videoStats; if (v && v.readable) { %>
          <div class="rpt-record-only" style="margin-top:1.5rem">
            <h2 class="rpt-h2">Seen in the video (<%= v.readable %> moments)</h2>
            <ul class="rpt-list" style="margin-top:.5rem">
              <li>Hands raised in <%= v.handsSeen %> of <%= v.handsJudged %> moments</li>
              <li>Students off task in <%= v.offTaskSeen %> of <%= v.offTaskJudged %> moments</li>
              <% if (v.teacherSeen) { %>
                <li>Teacher visible in <%= v.teacherSeen %> moments, moved between areas <%= v.moves %> times, close work with students in <%= v.closeWork %></li>
              <% } else { %>
                <li>Teacher not visible, so circulation cannot be judged</li>
              <% } %>
            </ul>
          </div>
        <% } %>
      </section>

      <details class="rpt-card rpt-fold rpt-report-only">
        <summary><h2 class="rpt-h2">Evidence by indicator</h2></summary>
        <p class="rpt-sub" style="margin-top:.4rem">What the scores above are based on, substrand by substrand.</p>
        <% report.strands.forEach((strand) => { %>
          <div style="margin-top:1rem">
            <h3 class="rpt-h3"><%= strand.name %></h3>
            <% strand.substrands.forEach((substrand) => { %>
              <details class="rpt-sub-fold">
                <summary>
                  <%= substrand.id %> <%= substrand.title %>:
                  <% if (substrand.observed) { %><span class="rpt-level-chip"><%= substrand.levelName %> (<%= substrand.percentage %>%)</span><% } else { %><span class="rpt-small">not observed</span><% } %>
                </summary>
                <div class="rpt-evidence" style="margin-top:.5rem; font-size:.9rem">
                  <% substrand.indicators.forEach((indicator) => { %>
                    <div style="padding:.5rem 0">
                      <p style="font-weight:600"><%= indicator.name %>: <%= indicator.levelName %> (<%= indicator.level %> of 5)</p>
                      <p style="color:var(--ink-soft)"><%= indicator.evidence %></p>
                    </div>
                  <% }) %>
                  <% if (substrand.notObserved.length) { %>
                    <div style="padding:.5rem 0" class="rpt-small">Not observed: <%= substrand.notObserved.join(', ') %></div>
                  <% } %>
                </div>
              </details>
            <% }) %>
          </div>
        <% }) %>
      </details>

      <% if (report.videoEvidence) { %>
        <details class="rpt-card rpt-fold rpt-report-only">
          <summary><h2 class="rpt-h2">Seen in the video</h2></summary>
          <p class="rpt-sub" style="margin-top:.4rem">Sampled moments only, so they can miss what happens between them.</p>
          <pre style="white-space:pre-wrap; font-family:var(--sans); font-size:.9rem; margin-top:.5rem"><%= report.videoEvidence %></pre>
        </details>
      <% } %>

      <% if (report.reflection.length) { %>
        <details class="rpt-card rpt-fold rpt-report-only">
          <summary><h2 class="rpt-h2">Teacher's reflection</h2></summary>
          <div style="margin-top:.75rem">
            <% report.reflection.forEach((turn) => { %>
              <div style="margin-top:.75rem; font-size:.95rem">
                <p class="rpt-sub" style="font-size:1rem"><%= turn.question %></p>
                <p style="margin-top:.2rem"><%= turn.answer %></p>
              </div>
            <% }) %>
          </div>
        </details>
      <% } %>
    <% } %>
  </div>

  <script src="/js/csp-actions.js"></script>
  <script nonce="<%= cspNonce %>">
    // Download as PDF through the print dialog. Two kinds: the full report (the Download PDF button, or Ctrl+P) and the
    // observation record (level, action step, glows, grows, note, video counts). Everything folded on screen is
    // opened and the file is named after the teacher and date; both are put back afterwards.
    // ?download=report or ?download=record (the links on the coaching list) opens the dialog on arrival.
    (function () {
      var page = document.querySelector('.rpt-page');
      var opened = [];
      var title = document.title;

      function print(kind) {
        document.body.dataset.print = kind;
        window.print();
      }
      function printReport() { print('report'); }
      function printRecord() { print('record'); }
      window.cspActions.register({ printReport: printReport, printRecord: printRecord });

      window.addEventListener('beforeprint', function () {
        opened = Array.prototype.filter.call(document.querySelectorAll('.rpt-page details:not([open])'), function (d) {
          return !d.closest('.rpt-noprint');
        });
        opened.forEach(function (d) { d.open = true; });
        var kind = document.body.dataset.print === 'record' ? 'Observation record' : 'Observation report';
        if (page && page.dataset.printName) document.title = kind + ' - ' + page.dataset.printName;
      });
      window.addEventListener('afterprint', function () {
        opened.forEach(function (d) { d.open = false; });
        opened = [];
        document.title = title;
        delete document.body.dataset.print;
      });

      var wanted = new URLSearchParams(window.location.search).get('download');
      if (wanted === 'report' || (wanted === 'record' && document.querySelector('[data-on-click="printRecord"]'))) {
        window.addEventListener('load', function () { setTimeout(function () { print(wanted); }, 300); });
      }
    })();
  </script>
</body>
</html>
