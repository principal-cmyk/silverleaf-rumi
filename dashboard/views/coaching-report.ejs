<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Rumi Observability Portal</title>
  <link rel="icon" type="image/png" href="/images/rumi-logo.png">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-coaching-gradient min-h-screen">
  <%- include("partials/navigation", { currentPage: "coaching", username: username, userRole: userRole }) %>

  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <a href="/observability/coaching" class="text-sm text-blue-800">← All coaching sessions</a>

    <div class="bg-white rounded-lg shadow p-6">
      <h1 class="text-2xl font-bold text-gray-900">📋 Observation report</h1>
      <p class="text-gray-700 mt-1">
        <%= report.teacher %><% if (report.school) { %> · <%= report.school %><% } %>
        · <%= new Date(report.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
        <% if (report.durationSeconds) { %> · <%= Math.floor(report.durationSeconds / 60) %>:<%= String(report.durationSeconds % 60).padStart(2, '0') %> min<% } %>
      </p>
      <% if (report.available && (report.subject || report.topic)) { %>
        <p class="text-gray-700"><%= [report.subject, report.topic].filter(Boolean).join(' · ') %></p>
      <% } %>
      <% if (report.summary) { %><p class="text-gray-700 mt-3"><%= report.summary %></p><% } %>
    </div>

    <% if (!report.available) { %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-yellow-800">
        There is no full report for this lesson, because it was scored before the Silverleaf framework was in use.
      </div>
    <% } else { %>
      <div class="bg-white rounded-lg shadow p-6">
        <p class="text-3xl font-bold text-gray-900"><%= report.record.overall_level || 'Not rated' %></p>
        <p class="text-gray-700">
          <%= report.scores.overall_percentage %>% across the <%= report.scores.rated_indicators %> indicators this lesson could show,
          out of <%= report.scores.total_indicators %>. Indicators not observed do not lower this score.
        </p>
        <% if (report.record.lesson_start_seen === false) { %>
          <p class="text-sm text-gray-500 mt-2">This recording does not show the start of the lesson, so the lesson opening is not observed.</p>
        <% } %>
      </div>

      <div class="bg-white rounded-lg shadow p-6 space-y-3">
        <h2 class="text-xl font-bold text-gray-900">🎯 Action step</h2>
        <% if (report.record.needs_review) { %>
          <p class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 text-sm text-yellow-800">
            A coach should review this step. It did not fully meet the rules: one move, drawn from the grows.
          </p>
        <% } %>
        <p class="text-gray-900"><%= report.record.action_step %></p>
        <% if (report.record.how && report.record.how.length) { %>
          <ol class="list-decimal ml-5 text-gray-700">
            <% report.record.how.forEach((step) => { %><li><%= step %></li><% }) %>
          </ol>
        <% } %>
        <p class="text-sm text-gray-500"><%= [report.record.category, report.record.type, report.record.gbf_phase, report.record.gbf_skill].filter(Boolean).join(' · ') %></p>
        <% if (report.record.source_grow) { %>
          <p class="text-sm text-gray-700"><span class="font-medium">Drawn from this grow:</span> <%= report.record.source_grow %></p>
        <% } %>
        <% if (report.record.rationale) { %><p class="text-sm text-gray-700"><%= report.record.rationale %></p><% } %>
      </div>

      <div class="bg-white rounded-lg shadow p-6 space-y-4">
        <div>
          <h2 class="text-xl font-bold text-gray-900">✨ Glows</h2>
          <ul class="list-disc ml-5 text-gray-700"><% (report.record.glows || []).forEach((glow) => { %><li><%= glow %></li><% }) %></ul>
        </div>
        <div>
          <h2 class="text-xl font-bold text-gray-900">🌱 Grows</h2>
          <ul class="list-disc ml-5 text-gray-700"><% (report.record.grows || []).forEach((grow) => { %><li><%= grow %></li><% }) %></ul>
        </div>
        <% if (report.record.notes_for_teacher) { %>
          <div>
            <h2 class="text-xl font-bold text-gray-900">💬 Note for the teacher</h2>
            <p class="text-gray-700"><%= report.record.notes_for_teacher %></p>
          </div>
        <% } %>
      </div>

      <% report.strands.forEach((strand) => { %>
        <div class="bg-white rounded-lg shadow p-6 space-y-3">
          <h2 class="text-xl font-bold text-gray-900"><%= strand.name %></h2>
          <% strand.substrands.forEach((substrand) => { %>
            <details class="border border-gray-200 rounded-lg p-3" <%= substrand.observed ? 'open' : '' %>>
              <summary class="cursor-pointer font-medium text-gray-900">
                <%= substrand.id %> <%= substrand.title %>:
                <% if (substrand.observed) { %><%= substrand.levelName %> (<%= substrand.percentage %>%)<% } else { %>not observed<% } %>
              </summary>
              <div class="mt-3 divide-y text-sm">
                <% substrand.indicators.forEach((indicator) => { %>
                  <div class="py-2">
                    <p class="font-medium text-gray-900"><%= indicator.name %>: <%= indicator.levelName %> (<%= indicator.level %> of 5)</p>
                    <p class="text-gray-700"><%= indicator.evidence %></p>
                  </div>
                <% }) %>
                <% if (substrand.notObserved.length) { %>
                  <p class="py-2 text-gray-500">Not observed: <%= substrand.notObserved.join(', ') %></p>
                <% } %>
              </div>
            </details>
          <% }) %>
        </div>
      <% }) %>

      <% if (report.videoEvidence) { %>
        <details class="bg-white rounded-lg shadow p-6">
          <summary class="cursor-pointer text-xl font-bold text-gray-900">🎥 Seen in the video</summary>
          <p class="text-sm text-gray-500 mt-2">Sampled moments only, so they can miss what happens between them.</p>
          <pre class="text-sm text-gray-700 mt-2 whitespace-pre-wrap"><%= report.videoEvidence %></pre>
        </details>
      <% } %>

      <% if (report.reflection.length) { %>
        <div class="bg-white rounded-lg shadow p-6 space-y-3">
          <h2 class="text-xl font-bold text-gray-900">💭 Teacher's reflection</h2>
          <% report.reflection.forEach((turn) => { %>
            <div class="text-sm">
              <p class="font-medium text-gray-900"><%= turn.question %></p>
              <p class="text-gray-700"><%= turn.answer %></p>
            </div>
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </div>
</body>
</html>
